rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Main portfolio document
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
