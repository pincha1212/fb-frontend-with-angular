{
  "entities": {
    "PortfolioData": {
      "title": "PortfolioData",
      "description": "Portafolio editable de Federico Barzola",
      "type": "object",
      "properties": {
        "profile": {
          "type": "object",
          "description": "Información general y sobre mí"
        },
        "proyectos": {
          "type": "array",
          "description": "Lista de proyectos del portafolio"
        },
        "habilidades": {
          "type": "array",
          "description": "Lista de habilidades y tecnologías"
        },
        "experiencia": {
          "type": "array",
          "description": "Lista de trayectoria y experiencia"
        },
        "contacto": {
          "type": "object",
          "description": "Información de contacto"
        },
        "updatedAt": {
          "type": "string",
          "description": "Fecha de actualización ISO8601",
          "maxLength": 64
        }
      },
      "required": ["updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrador autorizado del portafolio",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Correo del administrador",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Rol de acceso",
          "maxLength": 32
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/portfolio/main": {
      "schema": "PortfolioData",
      "description": "Documento principal con la información editable del portafolio"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Documentos de administradores autorizados"
    }
  }
}
